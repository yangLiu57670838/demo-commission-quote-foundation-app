# Committed demo env:
# - .env.local is loaded by pnpm dev on this machine
# - .env.dev is injected by Docker Compose
# .env stays gitignored for a private override. The key below is a placeholder.

VENDOR_API_URL=http://localhost:4001
BFF_URL=http://localhost:4000
VENDOR_API_KEY=replace-with-local-key
VENDOR_TIMEOUT_MS=2000
VENDOR_FAILURE_RATE=0.2
ENABLE_COMMISSION_QUOTE=true
